rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUserStoreId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId;
    }

    function isStoreMember(sid) {
      return isAuth() && (
        request.auth.uid == sid ||
        getUserStoreId() == sid
      );
    }

    // Per-store collections: accessible only to that store's authorized members
    match /stores/{sid}/{document=**} {
      allow read, write: if isStoreMember(sid);
    }

    // User profile mapping
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Store codes mapping
    match /codes/{code} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.storeId == request.auth.uid;
    }

    // Platform config
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if false; // Server or platform admin only
    }

    // Subscription requests
    match /subscriptionRequests/{bizId} {
      allow read, write: if isAuth() && (request.auth.uid == bizId || getUserStoreId() == bizId);
    }

    // Support requests
    match /supportRequests/{docId} {
      allow create: if isAuth();
      allow read, update, delete: if false; // Platform admin only
    }

    // ========================================================
    // SHARED DEALER-TO-DEALER ORDERS (Top-level collection)
    // ========================================================
    match /dealerOrders/{orderId} {
      // 1. READ ACCESS:
      // Scoped strictly to the buyer or seller business.
      // An unrelated third business receives PERMISSION_DENIED.
      allow read: if isAuth() && (
        request.auth.uid == resource.data.buyerBusinessId ||
        getUserStoreId() == resource.data.buyerBusinessId ||
        request.auth.uid == resource.data.sellerBusinessId ||
        getUserStoreId() == resource.data.sellerBusinessId
      );

      // 2. CREATE ACCESS:
      // Only the buyer business can place a new order.
      // Must start with status == 'submitted'.
      allow create: if isAuth() && (
        (request.auth.uid == request.resource.data.buyerBusinessId || getUserStoreId() == request.resource.data.buyerBusinessId) &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.buyerBusinessId != null &&
        request.resource.data.sellerBusinessId != null &&
        request.resource.data.buyerBusinessId != request.resource.data.sellerBusinessId
      );

      // 3. WRITE / UPDATE ACCESS:
      // Server-side enforcement of state transitions.
      // Parties CANNOT reassign buyerBusinessId or sellerBusinessId.
      allow update: if isAuth() && (
        request.resource.data.buyerBusinessId == resource.data.buyerBusinessId &&
        request.resource.data.sellerBusinessId == resource.data.sellerBusinessId &&
        (
          // Case A: SELLER can accept, partial-accept, reject, pack, dispatch, or close
          (
            (request.auth.uid == resource.data.sellerBusinessId || getUserStoreId() == resource.data.sellerBusinessId) &&
            (
              // Accept or Reject when submitted
              (resource.data.status == 'submitted' && (
                request.resource.data.status == 'accepted' ||
                request.resource.data.status == 'partial' ||
                request.resource.data.status == 'rejected'
              )) ||
              // Pack when accepted
              ((resource.data.status == 'accepted' || resource.data.status == 'partial') &&
                request.resource.data.status == 'packed'
              ) ||
              // Dispatch when packed
              (resource.data.status == 'packed' &&
                request.resource.data.status == 'dispatched' &&
                request.resource.data.carrier != null &&
                request.resource.data.lr != null
              ) ||
              // Close when delivered
              (resource.data.status == 'delivered' &&
                request.resource.data.status == 'closed'
              )
            )
          ) ||

          // Case B: BUYER can confirm delivery
          (
            (request.auth.uid == resource.data.buyerBusinessId || getUserStoreId() == resource.data.buyerBusinessId) &&
            (
              resource.data.status == 'dispatched' &&
              request.resource.data.status == 'delivered'
            )
          )
        )
      );

      // 4. DELETE ACCESS:
      // Orders cannot be deleted to preserve audit trails & GST statutory compliance.
      allow delete: if false;
    }
  }
}
